# Routes the app's OpenAI clients through the LiteLLM proxy.
OPENAI_BASE_URL=http://litellm:4000/v1
OPENAI_API_KEY=sk-litellm-dev
LLM_PROVIDER=openai
CHAT_MODEL=chat-model
EMBEDDING_MODEL=embedding-model
GUIDANCE_DIR=guidance
VECTOR_STORE_DIR=.vector_store
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVAL_K=4
TEMPERATURE=0
TOOL_TIMEOUT_SECONDS=5
