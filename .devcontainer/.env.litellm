# Template copied to .env on first container create. Set OPENAI_API_KEY yourself.
OPENAI_BASE_URL="https://litellm-api.apps.ocp-prod.nnlscience.onmicrosoft.com/v1"
OPENAI_API_KEY=replace-me
SSL_CERT_FILE=/workspaces/RAG-Classifier/certs/nnl-ca.pem
LLM_PROVIDER=openai
CHAT_MODEL="gpt-oss-120b-continue-gpt-5"
EMBEDDING_MODEL="sentence-transformers-all-MiniLM-L6-v2"
GUIDANCE_DIR=guidance
VECTOR_STORE_DIR=.vector_store
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVAL_K=4
TEMPERATURE=0
TOOL_TIMEOUT_SECONDS=5
