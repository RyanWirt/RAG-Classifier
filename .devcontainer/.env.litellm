OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_PROVIDER=openai
GUIDANCE_DIR=guidance
VECTOR_STORE_DIR=.vector_store
CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
VISION_MODEL=gpt-4o-mini
